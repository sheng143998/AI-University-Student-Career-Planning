<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itsheng.service.mapper.UserVectorStoreMapper">

    <!-- 结果映射 -->
    <resultMap id="UserVectorStoreResult" type="com.itsheng.pojo.entity.UserVectorStore">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="resumeContent"/>
        <result column="resume_file_path" property="resumeFilePath"/>
        <result column="vector_type" property="vectorType"/>
        <result column="embedding" property="embeddingVector"/>
        <result column="metadata" property="metadata"/>
        <result column="create_time" property="createTime" javaType="java.time.LocalDateTime"/>
        <result column="update_time" property="updateTime" javaType="java.time.LocalDateTime"/>
    </resultMap>

    <insert id="upsert" parameterType="com.itsheng.pojo.entity.UserVectorStore">
        INSERT INTO ai_career_plan.user_vector_store (
            id,
            user_id,
            content,
            resume_file_path,
            vector_type,
            metadata,
            create_time,
            update_time
        ) VALUES (
            #{id},
            #{userId},
            #{resumeContent},
            #{resumeFilePath},
            #{vectorType},
            #{metadata}::jsonb,
            #{createTime},
            #{updateTime}
        )
        ON CONFLICT (id) DO UPDATE
        SET user_id = EXCLUDED.user_id,
            content = EXCLUDED.content,
            resume_file_path = EXCLUDED.resume_file_path,
            vector_type = EXCLUDED.vector_type,
            metadata = EXCLUDED.metadata,
            update_time = EXCLUDED.update_time
    </insert>


    <!-- 动态更新 user_vector_store 表记录（只更新非 null 字段） -->
    <update id="update" parameterType="com.itsheng.pojo.entity.UserVectorStore">
        UPDATE ai_career_plan.user_vector_store
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="resumeContent != null">content = #{resumeContent},</if>
            <if test="resumeFilePath != null">resume_file_path = #{resumeFilePath},</if>
            <if test="vectorType != null">vector_type = #{vectorType},</if>
            <if test="metadata != null">metadata = #{metadata},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据 ID 查询向量存储记录 -->
    <select id="selectByVectorStoreId" resultMap="UserVectorStoreResult">
        SELECT *
        FROM ai_career_plan.user_vector_store
        WHERE id = #{id}
    </select>

    <!-- 根据 ID 和用户 ID 查询向量存储记录，避免跨用户读取简历正文 -->
    <select id="selectByVectorStoreIdAndUserId" resultMap="UserVectorStoreResult">
        SELECT *
        FROM ai_career_plan.user_vector_store
        WHERE id = #{id}
          AND user_id = #{userId}
        LIMIT 1
    </select>

</mapper>
